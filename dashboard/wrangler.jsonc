{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threads-cli-nextstop",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "NOTION_SIGNAL_REVIEW_DATA_SOURCE_ID": "1c78f7c4-8325-4838-aa5b-64c6c1b88a22"
  },
  "secrets": {
    "required": [
      "NOTION_TOKEN",
      "NEXTSTOP_EVENT_EMIT_TOKEN"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "MCP_EVENTS_KV",
      "id": "b39f1b8eaa1644ec9e368968b5c037dd"
    }
  ]
}
