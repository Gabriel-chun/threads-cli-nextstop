    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-handler": "^2.2.0",
    "next": "16.3.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.2.0",
    "fflate": "^0.8.2",
    "@vercel/blob": "^2.6.1",
    "standardwebhooks": "^1.0.0",
    "@notionhq/client": "^5.26.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "vinext": "latest",
    "@vinext/cloudflare": "latest",
    "@cloudflare/vite-plugin": "latest",
    "vite": "latest",
    "wrangler": "latest"
  },
  "type": "module"
}
