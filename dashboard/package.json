{
  "name": "next-stop-live-dashboard",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:events": "tsx --test lib/mcpEvents/*.test.ts",
    "test:deck-feedback": "tsx --test lib/signalDeckFeedback.test.ts",
    "dev:vinext": "vite dev --port 3001",
